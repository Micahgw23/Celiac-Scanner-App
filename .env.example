# Copy this file to .env and fill in the values from your Firebase project:
# Firebase Console -> Project Settings -> General -> "Your apps" -> SDK setup and configuration.
#
# Before this will work, in the Firebase Console you also need to:
#   1. Authentication -> Sign-in method -> enable "Anonymous"
#   2. Firestore Database -> Create database -> Native mode
#   3. Deploy firestore.rules (see README) so users can only read/write their own data
#
# Expo automatically inlines any EXPO_PUBLIC_* variable into the app bundle,
# so no extra config is needed to use these in src/lib/firebase.ts.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL of the deployed AI proxy worker (see worker/README.md).
# e.g. https://food-scanner-ai.<your-subdomain>.workers.dev
# The worker URL is safe to ship; the OpenRouter API key lives ONLY as a
# Wrangler secret on the worker and must never appear in this app.
EXPO_PUBLIC_AI_PROXY_URL=
